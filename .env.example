# Copy of the settings the app reads from .env. Do not put a real key here.
# scripts/setup_dev.py creates the real .env for you.

# 32 random bytes, base64-encoded (SR-21)
SP_ENCRYPTION_KEY=

# Shared secret the gate simulator sends with every gate event (SR-20).
# At least 32 characters.
SP_GATE_KEY=

# Optional: a different database file
# SP_DATABASE=instance/smart_parking.db
